// ==========================================
// SEBA - Archangel V5
// 145 BPM | G Minor
// Switch Angel Prebake Required
// ==========================================

setcpm(145/4)


// ==========================================
// MAIN ACID SYNTH
// ==========================================
 
const acidCore = note(
  "g1 g1 bb1 g2 g1 d2 f1 d2"
)
  .fast(2)
  .s("sawtooth")
  .acidenv(0.42)
  .lpf(sine.range(450, 2600).slow(8))
  .lpq(9)
  .ftype("ladder")
  .decay(0.16)
  .sustain(0.08)
  .release(0.08)
  .distort("1.5:.45")
  .gain(0.24)
  .orbit(2)

const acidLayer = note(
  "g2 g2 bb2 g3 g2 d3 f2 d3"
)
  .fast(2)
  .s("supersaw")
  .unison(5)
  .detune(0.18)
  .spread(0.45)
  .lpf(sine.range(700, 3000).slow(8))
  .lpq(3)
  .ftype("ladder")
  .attack(0.005)
  .decay(0.16)
  .sustain(0.10)
  .release(0.10)
  .room(0.12)
  .gain(0.10)
  .orbit(2)

const acid = stack(
  acidCore,
  acidLayer
)


// ==========================================
// DRUMS & SIDECHAIN
// ==========================================

const kick = s("bd*4")
  .bank("RolandTR909")
  .gain(0.75)
  .orbit(1)
  .duckorbit("2:3")
  .duckattack("0.18:0.18")
  .duckdepth("0.65:0.85")

const hats = s("~ hh ~ hh ~ hh ~ hh")
  .bank("RolandTR909")
  .gain(0.28)
  .orbit(1)

const clap = s("~ cp ~ cp")
  .bank("RolandTR909")
  .gain(0.40)
  .orbit(1)


// ==========================================
// ROLLING BASS
// ==========================================

const bass = note("~ g1 ~ g1 ~ g1 ~ g1")
  .s("sawtooth")
  .lpf(280)
  .decay(0.14)
  .sustain(0)
  .gain(0.14)
  .orbit(3)


// ==========================================
// BUILDUP SNARES
// ==========================================

const snareRoll = s("sd*8")
  .bank("RolandTR909")
  .gain(0.22)
  .orbit(1)

const fastSnare = s("sd*16")
  .bank("RolandTR909")
  .gain(0.27)
  .orbit(1)


// ==========================================
// RISING NOISE SWEEP
// ==========================================

// Runs across 8 bars
// Gradually gets brighter and louder

const riser = s("white*8")
  .slow(8)
  .lpf(saw.range(300, 9000).slow(8))
  .hpf(200)
  .gain(saw.range(0.01, 0.16).slow(8))
  .decay(1.2)
  .sustain(0)
  .orbit(4)


// ==========================================
// DOWNLIFTER
// ==========================================

// Descending noise sweep
// Plays during the first bar of each drop

const downlifter = s("white*16")
  .lpf(saw.range(7000, 350))
  .gain(saw.range(0.10, 0.005))
  .decay(0.20)
  .sustain(0)
  .room(0.12)
  .orbit(4)


// ==========================================
// DROP CRASH
// ==========================================

const crash = s("cr")
  .bank("RolandTR909")
  .gain(0.25)
  .room(0.20)
  .orbit(1)


// ==========================================
// LOW IMPACT
// ==========================================

const impact = note("g1")
  .s("sine")
  .attack(0.001)
  .decay(0.45)
  .sustain(0)
  .release(0.10)
  .gain(0.30)
  .orbit(4)


// ==========================================
// BREAKBEAT
// ==========================================

const breakDrums = stack(

  s("bd ~ ~ bd ~ ~ bd ~")
    .bank("RolandTR909")
    .gain(0.65),

  s("~ ~ ~ ~ sd ~ ~ ~")
    .bank("RolandTR909")
    .gain(0.40),

  s("hh*8")
    .bank("RolandTR909")
    .gain(0.18)

)


// ==========================================
// DROP INSTRUMENTS
// ==========================================

const fullDrop = stack(
  kick,
  hats,
  clap,
  bass,
  acid.gain(0.32)
)

const dropTransition = stack(
  fullDrop,
  crash,
  downlifter,
  impact
)


// ==========================================
// SONG ARRANGEMENT
// ==========================================

arrange(

  // INTRO - 16 BARS
 
  [ , stack(
    kick,
    acid.gain(0.20)
  )],


  // BUILDUP 1 - FIRST 8 BARS

  [8, stack(
    kick,
    hats,
    acid.gain(0.24),
    snareRoll
  )],


  // BUILDUP 1 - FINAL 8 BARS
  // Rising noise enters

  [8, stack(
    kick,
    hats,
    acid.gain(0.30),
    fastSnare,
    riser
  )],


  // DROP 1 - FIRST BAR
  // Crash, downlifter and impact

  [1, dropTransition],


  // DROP 1 - REMAINING 31 BARS

  [31, fullDrop],


  // SECOND SECTION - 16 BARS

  [16, stack(
    kick,
    hats,
    bass,
    acid.gain(0.25)
  )],


  // BREAKBEAT - 16 BARS

  [16, stack(
    breakDrums,
    acid.gain(0.18)
  )],


  // BUILDUP 2 - FIRST 8 BARS

  [8, stack(
    kick,
    hats,
    acid.gain(0.24),
    snareRoll
  )],


  // BUILDUP 2 - FINAL 8 BARS

  [8, stack(
    kick,
    hats,
    acid.gain(0.30),
    fastSnare,
    riser
  )],


  // FINAL DROP - FIRST BAR
  // Crash, downlifter and impact

  [1, dropTransition],


  // FINAL DROP - REMAINING 31 BARS

  [31, fullDrop],


  // OUTRO - 16 BARS

  [16, stack(
    kick,
    acid.gain(0.16)
  )]

)
